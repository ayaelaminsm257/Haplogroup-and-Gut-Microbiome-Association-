# Bash code
module load PLINK2

# 1. Keep only the people in the analysis
plink2 --bfile awigen --keep keep_snp.txt --make-bed --out awigen_snp      # keep_snp.txt previously made from samples with complete metadata

# 2. LD-prune the nuclear variants (window 200 SNPs, step 50, r2 < 0.1)
plink2 --bfile awigen_snp --indep-pairwise 200 50 0.1 --out pruned_snp

# 3. Principal components on the pruned set (10 PCs)
plink2 --bfile awigen_snp --extract pruned_snp.prune.in --pca 10 --out ancestry_snp

# R code

ancestry.eigenvec <- read.table("ancestry_snp.eigenvec", header = TRUE, comment.char = "")
# columns: #FID/FID, IID, PC1, PC2, ... PC10
pcs <- ancestry.eigenvec[, c("IID", "PC1", "PC2", "PC3")]

# link genotype IDs (e.g. "AB0011") to microbiome IDs (e.g. "AG001") using the same ID mapping you used for `geno`, then:
meta_all$PC1 <- pcs$PC1[match(meta_all$general_study_id, pcs$IID)]
meta_all$PC2 <- pcs$PC2[match(meta_all$general_study_id, pcs$IID)]
meta_all$PC3 <- pcs$PC3[match(meta_all$general_study_id, pcs$IID)]

# Start Analysis

library(Maaslin2)
 
REFERENCE <- "L0"                   
PCS_USED  <- c("PC1", "PC2", "PC3") # PC4/PC5 are driven by a few outliers, so they are left out
 
# ---------------------------------------------------------
# Function: fit MaAsLin2 and keep only the haplogroup rows, BH over those tests

run_maaslin <- function(counts, meta, label, extra = NULL, suffix = "") {
 
  ids    <- intersect(rownames(counts), rownames(meta))
  counts <- counts[ids, ]
  meta   <- meta[ids, ]
  meta$Haplogroup_group <- relevel(factor(meta$Haplogroup_group), ref = REFERENCE)
  meta$general_site     <- factor(meta$general_site)
 
  outdir <- paste0("maaslin_", tolower(label), "_site_fixed_ref", REFERENCE, suffix)
 
  fit <- Maaslin2(
    input_data      = counts,
    input_metadata  = meta,
    output          = outdir,
    fixed_effects   = c("Haplogroup_group", "demographic_age", "anthropometric_bmi",
                        "antibiotics_collapsed", "general_site", extra),
    reference       = c(paste0("Haplogroup_group,", REFERENCE)),
    normalization   = "TSS",
    transform       = "LOG",
    analysis_method = "LM",
    min_prevalence  = 0,
    min_abundance   = 0,
    plot_heatmap    = FALSE,
    plot_scatter    = FALSE
  )
 
  # MaAsLin2's own qval is pooled over every term, so recompute over haplogroup rows only
  res <- read.table(file.path(outdir, "all_results.tsv"), header = TRUE, sep = "\t")
  hap <- res[res$metadata == "Haplogroup_group", ]
  hap$qval_haplogroup <- p.adjust(hap$pval, method = "BH")
  hap <- hap[order(hap$pval), ]
 
  cat("\n=====", label, suffix, ": haplogroup vs", REFERENCE, "(site fixed) =====\n")
  cat("Nominal p < 0.05:", sum(hap$pval < 0.05),
      "| BH q < 0.05:", sum(hap$qval_haplogroup < 0.05),
      "| BH q < 0.25:", sum(hap$qval_haplogroup < 0.25), "\n")
  print(head(hap[, c("feature", "value", "coef", "stderr", "N", "N.not.0",
                     "pval", "qval_haplogroup")], 15), row.names = FALSE)
 
  write.csv(hap, paste0(outdir, "_haplogroup_results.csv"), row.names = FALSE)
  invisible(hap)
}
 
