# Model A: main model, no PCs
# ---------------------------------------------------------
species_res <- run_maaslin(species_filtered, maaslin_metadata_filtered,       "Species")
genus_res   <- run_maaslin(genus_filtered,   maaslin_genus_metadata_filtered, "Genus")
 
# ---------------------------------------------------------
# Model B: same model plus ancestry PCs (sensitivity analysis)
# ---------------------------------------------------------
stopifnot(all(rownames(maaslin_metadata_filtered) %in% rownames(pcs)),
          all(rownames(maaslin_genus_metadata_filtered) %in% rownames(pcs)))
 
meta_pc       <- cbind(maaslin_metadata_filtered,
                       pcs[rownames(maaslin_metadata_filtered), PCS_USED])
meta_genus_pc <- cbind(maaslin_genus_metadata_filtered,
                       pcs[rownames(maaslin_genus_metadata_filtered), PCS_USED])
 
species_pc <- run_maaslin(species_filtered, meta_pc,       "Species", extra = PCS_USED, suffix = "_pcs")
genus_pc   <- run_maaslin(genus_filtered,   meta_genus_pc, "Genus",   extra = PCS_USED, suffix = "_pcs")
 
# ---------------------------------------------------------
# Compare: did adding the PCs change the haplogroup effects?

compare_models <- function(a, b, label) {
  cmp <- merge(a[, c("feature", "value", "coef", "pval", "qval_haplogroup")],
               b[, c("feature", "value", "coef", "pval", "qval_haplogroup")],
               by = c("feature", "value"), suffixes = c("_noPC", "_PC"))
  cat("\n=====", label, ": with vs without ancestry PCs =====\n")
  cat("Correlation of haplogroup coefficients:", round(cor(cmp$coef_noPC, cmp$coef_PC), 3), "\n")
  cat("Same direction of effect:", round(mean(sign(cmp$coef_noPC) == sign(cmp$coef_PC)) * 100, 1), "%\n")
  cat("BH q < 0.05 without PCs:", sum(cmp$qval_haplogroup_noPC < 0.05),
      "| with PCs:", sum(cmp$qval_haplogroup_PC < 0.05), "\n")
  cat("Top 10 by p-value without PCs:\n")
  print(head(cmp[order(cmp$pval_noPC), ], 10), row.names = FALSE)
  invisible(cmp)
}
 
cmp_species <- compare_models(species_res, species_pc, "Species")
cmp_genus   <- compare_models(genus_res,   genus_pc,   "Genus")
 
write.csv(cmp_species, "species_with_vs_without_pcs.csv", row.names = FALSE)
write.csv(cmp_genus,   "genus_with_vs_without_pcs.csv",   row.names = FALSE)
