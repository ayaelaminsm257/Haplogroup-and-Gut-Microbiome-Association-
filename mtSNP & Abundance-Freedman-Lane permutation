# 2. All SNPs passing QC (no tagging) and the cluster map
# ---------------------------------------------------------
stopifnot(exists("geno"), exists("tags_all"), exists("meta_all"))
call_rate <- colMeans(!is.na(geno))
n1  <- colSums(geno == 1, na.rm = TRUE); n0 <- colSums(geno == 0, na.rm = TRUE)
mac <- pmin(n1, n0); maf <- mac / (n1 + n0)
G_all <- geno[, call_rate >= 0.95 & mac >= 15 & maf >= 0.05, drop = FALSE]
cat("SNPs passing QC:", ncol(G_all), "| people:", nrow(G_all),
    "| clusters:", nrow(tags_all), "\n")                # expect ~138, ~1,419, 46

members <- strsplit(tags_all$members, ";")
snp2tag <- setNames(rep(tags_all$tag, lengths(members)), unlist(members))
nmem    <- setNames(tags_all$n_members, tags_all$tag)

# ---------------------------------------------------------
# 3. One function that runs a taxonomic level
# ---------------------------------------------------------
run_level <- function(count_table, label) {
  cnt <- as.matrix(count_table)
  cnt <- cnt[intersect(rownames(cnt), rownames(meta_all)), , drop = FALSE]
  cnt <- cnt[rowSums(cnt) > 0, , drop = FALSE]
  Y   <- make_Y(cnt[, colMeans(cnt > 0) >= 0.10, drop = FALSE])   # 10% prevalence filter

  ids  <- Reduce(intersect, list(rownames(G_all), rownames(Y), rownames(meta_all)))
  Z_df <- meta_all[ids, c("demographic_age", "anthropometric_bmi", "antibiotics_collapsed",
                          "PC1", "PC2", "PC3", "general_site")]
  ok   <- complete.cases(Z_df); ids <- ids[ok]; Z_df <- Z_df[ok, ]
  cat("\n=====", label, "| people:", length(ids), "| SNPs:", ncol(G_all),
      "| taxa:", ncol(Y), "| tests:", ncol(G_all) * ncol(Y), "=====\n")

  res <- fl_full(as.matrix(G_all[ids, ]), as.matrix(Y[ids, ]), make_Z(Z_df),
                 factor(Z_df$general_site))
  res$cluster      <- snp2tag[res$snp]
  res$cluster_size <- nmem[res$cluster]
  res$q_BH_snp     <- p.adjust(res$p_param, "BH")                 # over every SNP x taxon test

  best <- res[order(res$p_param), ]
  best <- best[!duplicated(paste(best$cluster, best$taxon)), ]    # best SNP per cluster x taxon
  best$q_BH_cluster <- p.adjust(best$p_param, "BH")
  best <- best[order(best$p_param), ]

  cat("SNPs with no cluster:", sum(is.na(res$cluster)), "(should be 0)\n")
  cat("All-SNP tests:", nrow(res), "| cluster-level tests:", nrow(best), "\n")
  cat("p < 0.05:", sum(res$p_param < 0.05), "(expected:", round(0.05 * nrow(res)), ")\n")
  cat("Smallest p:", signif(min(res$p_param), 3),
      "| smallest BH q (all SNPs):", signif(min(res$q_BH_snp), 3),
      "| (clusters):", signif(min(best$q_BH_cluster), 3),
      "| smallest max-T p:", signif(min(res$p_maxT), 3), "\n\n")
  print(head(best[, c("cluster", "snp", "cluster_size", "taxon", "beta", "se",
                      "p_param", "p_perm", "p_maxT", "q_BH_cluster")], 15),
        row.names = FALSE, digits = 3)

  write.csv(res,  paste0(tolower(label), "_mtdna_FL_allSNPs.csv"),  row.names = FALSE)
  write.csv(best, paste0(tolower(label), "_mtdna_FL_clusters.csv"), row.names = FALSE)
  invisible(list(all = res, best = best))
}

