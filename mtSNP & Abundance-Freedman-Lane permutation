stopifnot(exists("geno"), exists("tags_all"), exists("meta_all"))
call_rate <- colMeans(!is.na(geno))
n1  <- colSums(geno == 1, na.rm = TRUE); n0 <- colSums(geno == 0, na.rm = TRUE)
