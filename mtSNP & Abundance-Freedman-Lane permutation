# ---------------------------------------------------------
# 3. One function that runs a taxonomic level
# ---------------------------------------------------------
run_level <- function(count_table, label) {
  cnt <- as.matrix(count_table)
  cnt <- cnt[intersect(rownames(cnt), rownames(meta_all)), , drop = FALSE]
  cnt <- cnt[rowSums(cnt) > 0, , drop = FALSE]
  Y   <- make_Y(cnt[, colMeans(cnt > 0) >= 0.10, drop = FALSE])   # 10% prevalence filter

  ids  <- Reduce(intersect, list(rownames(G_all), rownames(Y), rownames(meta_all)))
  Z_df <- meta_all[ids, c("demographic_age", "anthropometric_bmi", "antibiotics_collapsed",
                          "PC1", "PC2", "PC3", "general_site")]
  ok   <- complete.cases(Z_df); ids <- ids[ok]; Z_df <- Z_df[ok, ]
  G    <- as.matrix(G_all[ids, , drop = FALSE])
  Yk   <- as.matrix(Y[ids, , drop = FALSE])
  site <- factor(Z_df$general_site)
  Z    <- make_Z(Z_df)
  cat("\n=====", label, "| people:", length(ids), "| SNPs:", ncol(G),
      "| taxa:", ncol(Yk), "| tests:", ncol(G) * ncol(Yk), "=====\n")

  # per-test permutation on every SNP x taxon pair
  res <- fl_pertest(G, Yk, Z, site, n_perm = N_PERM)
  res$cluster      <- snp2tag[res$snp]
  res$cluster_size <- nmem[res$cluster]

  # group afterwards: best SNP per cluster x taxon, BH over the cluster-level tests
  best <- res[order(res$p_param), ]
  best <- best[!duplicated(paste(best$cluster, best$taxon)), ]
  best$q_BH_cluster <- p.adjust(best$p_param, "BH")
  best <- best[order(best$p_param), ]

  cat("SNPs with no cluster:", sum(is.na(res$cluster)), "(should be 0)\n")
  cat("All-SNP tests:", nrow(res), "| cluster-level tests:", nrow(best), "\n")
  cat("p < 0.05:", sum(best$p_param < 0.05), "(expected:", round(0.05 * nrow(best)), ")\n")
  cat("Smallest p:", signif(min(best$p_param), 3),
      "| smallest BH q (clusters):", signif(min(best$q_BH_cluster), 3), "\n\n")
  print(head(best[, c("cluster", "snp", "cluster_size", "taxon", "beta", "se",
                      "p_param", "p_perm", "q_BH_cluster")], 15), row.names = FALSE, digits = 3)

  # many more shuffles for the top hits only
  top <- head(best, N_TOP)
  top_hi <- do.call(rbind, lapply(seq_len(nrow(top)), function(i) {
    r <- fl_pertest(G[, top$snp[i], drop = FALSE], Yk[, top$taxon[i], drop = FALSE],
                    Z, site, n_perm = N_PERM_TOP, verbose = FALSE)
    data.frame(cluster = top$cluster[i], r[, c("snp", "taxon", "beta", "p_param", "p_perm")])
  }))
  cat("\nTop", N_TOP, "with", N_PERM_TOP, "shuffles:\n")
  print(top_hi, row.names = FALSE, digits = 3)

  write.csv(res,    paste0(tolower(label), "_mtdna_pertest_allSNPs.csv"),   row.names = FALSE)
  write.csv(best,   paste0(tolower(label), "_mtdna_pertest_clusters.csv"),  row.names = FALSE)
  write.csv(top_hi, paste0(tolower(label), "_mtdna_pertest_top_hi.csv"),    row.names = FALSE)
  invisible(list(all = res, best = best, top_hi = top_hi))
}

