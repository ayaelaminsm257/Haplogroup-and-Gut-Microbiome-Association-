# =============================================================================
# Freedman-Lane PER-TEST permutation (no max-T), all SNPs, grouped afterwards
# p_perm = (1 + shuffles with |t*| >= |t_obs|) / (n_perm + 1)
#        = how often THIS exact SNP-taxon pair gives a t this large under the null
# =============================================================================
N_PERM     <- 1000          
N_PERM_TOP <- 20000         # extra shuffles for the top hits only
N_TOP      <- 20
set.seed(1)

# ---------------------------------------------------------
# 1. Functions

make_Z <- function(Z_df) {
  Z_df[] <- lapply(Z_df, function(v) if (is.character(v)) factor(v) else v)
  model.matrix(~ ., data = Z_df)
}

make_Y <- function(counts) {
  prop <- counts / rowSums(counts)
  Y <- apply(prop, 2, function(x) { x[x == 0] <- min(x[x > 0]) / 2; log2(x) })
  rownames(Y) <- rownames(counts)
  Y
}

fl_pertest <- function(G, Y, Z, site, n_perm = N_PERM, verbose = TRUE) {
  stopifnot(nrow(G) == nrow(Y), nrow(Y) == nrow(Z), length(site) == nrow(Y))
  n <- nrow(Y)
  G <- apply(G, 2, function(g) { g[is.na(g)] <- mean(g, na.rm = TRUE); g })

  qz <- qr(Z); Q <- qr.Q(qz)[, seq_len(qz$rank), drop = FALSE]
  resid_Z <- function(M) M - Q %*% crossprod(Q, M)
  df <- n - qz$rank - 1

  Gr <- resid_Z(G); gg <- colSums(Gr^2)
  ok <- gg > 1e-8; Gr <- Gr[, ok, drop = FALSE]; gg <- gg[ok]
  R  <- resid_Z(Y)

  tstat <- function(Rm) {
    E   <- resid_Z(Rm)
    B   <- crossprod(Gr, Rm) / gg
    sse <- matrix(colSums(E^2), nrow = length(gg), ncol = ncol(E), byrow = TRUE) - B^2 * gg
    se  <- sqrt(pmax(sse, 1e-12) / df / gg)
    list(beta = B, se = se, t = B / se)
  }

  obs     <- tstat(Y)
  obs_abs <- abs(obs$t)
  count   <- matrix(0, nrow(obs_abs), ncol(obs_abs))      # shuffles at least as extreme, per test

  for (b in seq_len(n_perm)) {
    idx <- seq_len(n)
    for (s in levels(site)) { w <- which(site == s); idx[w] <- w[sample.int(length(w))] }
    count <- count + (abs(tstat(R[idx, , drop = FALSE])$t) >= obs_abs)
    if (verbose && b %% 100 == 0) cat("shuffle", b, "of", n_perm, "\n")
  }

  out <- data.frame(snp   = rep(colnames(Gr), times = ncol(Y)),
                    taxon = rep(colnames(Y),  each  = ncol(Gr)),
                    beta  = as.vector(obs$beta), se = as.vector(obs$se), t = as.vector(obs$t),
                    n_extreme = as.vector(count))
  out$p_param <- 2 * pt(-abs(out$t), df)                  # ordinary t-test p
  out$p_perm  <- (out$n_extreme + 1) / (n_perm + 1)       # per-test permutation p
  out[order(out$p_param), ]
}

