# =============================================================================
# Freedman-Lane permutation on ALL SNPs individually, then grouped into clusters
# Gives per-test permutation p (p_perm), family-wise max-T p (p_maxT) and BH q
# Run for species and for genus
# =============================================================================
N_PERM <- 1000                      # use 200 first to check the timing
set.seed(1)

# ---------------------------------------------------------
# 1. Functions
# ---------------------------------------------------------
make_Z <- function(Z_df) {                                                  # Build covariate design matrix
  Z_df[] <- lapply(Z_df, function(v) if (is.character(v)) factor(v) else v) # Convert character variables to factors (R doesnt accept characters)
  model.matrix(~ ., data = Z_df)                                            # Create model matrix with dummy variables and intercept
}

make_Y <- function(counts) {                                               # Convert counts to log2 relative abundance
  prop <- counts / rowSums(counts)
  Y <- apply(prop, 2, function(x) { x[x == 0] <- min(x[x > 0]) / 2; log2(x) }) # Replace zeros with half minimum non-zero abundance
  rownames(Y) <- rownames(counts)        # Log2(x) Reduce skewness and make abundance values more comparable
  Y
}

fl_full <- function(G, Y, Z, site, n_perm = N_PERM, verbose = TRUE) {  # Run Freedman-Lane on all SNP × taxon pairs
  stopifnot(nrow(G) == nrow(Y), nrow(Y) == nrow(Z), length(site) == nrow(Y))
  n <- nrow(Y)                                                     # Number of individuals
  G <- apply(G, 2, function(g) { g[is.na(g)] <- mean(g, na.rm = TRUE); g })  # Impute missing genotypes with SNP mean

  qz <- qr(Z); Q <- qr.Q(qz)[, seq_len(qz$rank), drop = FALSE] # QR decomposition of covariate matrix 
  resid_Z <- function(M) M - Q %*% crossprod(Q, M) # Residualize any matrix against covariates
  df <- n - qz$rank - 1    # Residual degrees of freedom

  Gr <- resid_Z(G); gg <- colSums(Gr^2)  # SNPs after removing covariate effects
  ok <- gg > 1e-8; Gr <- Gr[, ok, drop = FALSE]; gg <- gg[ok]  # Remove SNPs explained completely by covariates
  R  <- resid_Z(Y)   # Reduced-model residuals (unexplained abundance) 

  tstat <- function(Rm) {   # Compute beta, SE and t-statistics
    E   <- resid_Z(Rm)         # Residualize permuted abundance matrix (Y*)
    B   <- crossprod(Gr, Rm) / gg         # SNP effect size estimate (beta)
    sse <- matrix(colSums(E^2), nrow = length(gg), ncol = ncol(E), byrow = TRUE) - B^2 * gg
    se  <- sqrt(pmax(sse, 1e-12) / df / gg) # Standard error of beta
    list(beta = B, se = se, t = B / se)  # t-statistic for SNP effect
  }

  obs <- tstat(Y); obs_abs <- abs(obs$t) # Observed statistics from real data (tobs)
  count <- matrix(0, nrow(obs_abs), ncol(obs_abs)) # Per-test permutation counters
  maxT  <- numeric(n_perm)   # Maximum t-statistic from each permutation

  for (b in seq_len(n_perm)) {   # Repeat permutations
    idx <- seq_len(n)
    for (s in levels(site)) { w <- which(site == s); idx[w] <- w[sample.int(length(w))] } # Permute within site only & Shuffle individuals within site
    tt <- abs(tstat(R[idx, , drop = FALSE])$t)   # Calculate t-statistics from permuted residuals (Y∗=Y^+R∗)
    count   <- count + (tt >= obs_abs)          # per-test counter
    maxT[b] <- max(tt)                          # family-wise null (Largest t-statistic across all tests)
    if (verbose && b %% 100 == 0) cat("shuffle", b, "of", n_perm, "\n")
  }
# Build results table
  out <- data.frame(snp   = rep(colnames(Gr), times = ncol(Y)),
                    taxon = rep(colnames(Y),  each  = ncol(Gr)),
                    beta  = as.vector(obs$beta), se = as.vector(obs$se), t = as.vector(obs$t),
                    n_extreme = as.vector(count))
  out$p_param <- 2 * pt(-abs(out$t), df)   # Standard regression p-value
  out$p_perm  <- (out$n_extreme + 1) / (n_perm + 1)  # Per-test Freedman-Lane p-value
  out$p_maxT  <- (vapply(abs(out$t), function(x) sum(maxT >= x), numeric(1)) + 1) / (n_perm + 1)  How often did ANY SNP-taxon association in the entire scan produce a t-statistic this large?
  out <- out[order(out$p_param), ]
  attr(out, "maxT") <- maxT
  out
}

