# =========================================================
# RUN 2: ALL SITES, SEPARATELY, THEN COMBINED (meta-analysis)

# Each site is analysed on its own, so site can never confound the result.
# The per-site estimates are then combined, giving more weight to the more
# precise ones. 'I2' shows how much the sites disagree (0 = agree fully).
 
qc_all <- snp_qc(geno, MIN_CARRIERS, MAF_MIN)
cat("\nRUN 2: ", sum(qc_all$keep), " of ", ncol(geno), " SNPs pass the pooled filters\n", sep = "")
G_all  <- geno[, qc_all$keep, drop = FALSE]
tags_all <- choose_tags(G_all)
cat("Independent tag SNPs:", nrow(tags_all), "\n")
Gt_all <- G_all[, tags_all$tag, drop = FALSE]
 
# Prepare each site once (so the shuffles are quick)
site_prep <- lapply(sort(unique(meta_all$general_site)), function(s) {
  rows <- which(meta_all$general_site == s)
  qc   <- snp_qc(Gt_all[rows, , drop = FALSE], MIN_CARRIERS_SITE, maf_min = 0)
  keep_t <- colMeans(taxa_counts[rows, ] > 0) >= TAXA_PREV_MIN
  list(site = s, rows = rows, snps = qc$snp[qc$keep],
       Y = make_Y(taxa_counts[rows, keep_t, drop = FALSE]),
       X = cov_matrix(meta_all[rows, ], with_site = FALSE))
})
for (sp in site_prep)
  cat("  ", sp$site, ": n =", length(sp$rows), "| tag SNPs testable:", length(sp$snps),
      "| taxa:", ncol(sp$Y), "\n")
 
scan_sites <- function(Gt, shuffle = FALSE) {
  blank <- function() matrix(0, ncol(Gt), ncol(taxa_counts),
                             dimnames = list(colnames(Gt), colnames(taxa_counts)))
  W <- blank(); WB <- blank(); WB2 <- blank(); K <- blank()
  for (sp in site_prep) {
    if (length(sp$snps) == 0) next
    Gs <- Gt[sp$rows, sp$snps, drop = FALSE]
    if (shuffle) Gs <- Gs[sample.int(nrow(Gs)), , drop = FALSE]
    sc <- scan_all(Gs, sp$Y, sp$X)
    w  <- 1 / sc$se^2
    ok <- !is.na(w) & is.finite(w)
    rr <- rownames(sc$p); cc <- colnames(sc$p)
    W[rr, cc]   <- W[rr, cc]   + ifelse(ok, w, 0)
    WB[rr, cc]  <- WB[rr, cc]  + ifelse(ok, w * sc$beta, 0)
    WB2[rr, cc] <- WB2[rr, cc] + ifelse(ok, w * sc$beta^2, 0)
    K[rr, cc]   <- K[rr, cc]   + ok
  }
  beta <- WB / W
  se   <- 1 / sqrt(W)
  p    <- 2 * pnorm(-abs(beta / se))
  Q    <- WB2 - WB^2 / W                         # how much the sites disagree
  I2   <- pmax(0, (Q - (K - 1)) / Q)
  p[K < 2] <- NA                                 # need at least 2 sites
  list(beta = beta, se = se, p = p, k = K, I2 = I2)
}
 
sc2  <- scan_sites(Gt_all)
tab2 <- to_table(sc2)
tab2 <- merge(tab2, tags_all[, c("tag", "n_members", "members")], by.x = "snp", by.y = "tag", all.x = TRUE)
minp2 <- replicate(N_PERM, min(scan_sites(Gt_all, shuffle = TRUE)$p, na.rm = TRUE))
res2  <- report_scan(tab2, minp2, "RUN 2: all sites, combined across sites", "species_mtdna_run2_allsites_meta")
 
 
