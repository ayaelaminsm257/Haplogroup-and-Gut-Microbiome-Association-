# Which SNPs are common enough, and well enough called, to test?
snp_qc <- function(G, min_carriers, maf_min = MAF_MIN) {
  n1  <- colSums(G == 1, na.rm = TRUE)
  n0  <- colSums(G == 0, na.rm = TRUE)
  mac <- pmin(n1, n0)                        # minor allele count
  data.frame(snp = colnames(G),
             call_rate = colMeans(!is.na(G)),
             mac = mac, maf = mac / (n1 + n0),
             keep = colMeans(!is.na(G)) >= CALL_RATE_MIN & mac >= min_carriers &
                    mac / (n1 + n0) >= maf_min,
             row.names = NULL)
}
 
# Group SNPs that carry (almost) the same information; keep one tag per group
choose_tags <- function(G, r2 = R2_TAG) {
  if (ncol(G) == 1)
    return(data.frame(cluster = 1, tag = colnames(G), n_members = 1, members = colnames(G)))
  r <- suppressWarnings(cor(G, use = "pairwise.complete.obs"))
  r[is.na(r)] <- 0
  cl  <- cutree(hclust(as.dist(1 - r^2), method = "complete"), h = 1 - r2 + 1e-9)
  p1  <- colMeans(G == 1, na.rm = TRUE)
  maf <- pmin(p1, 1 - p1)
  do.call(rbind, lapply(sort(unique(cl)), function(k) {
    m <- names(cl)[cl == k]
    data.frame(cluster = k, tag = m[which.max(maf[m])],
               n_members = length(m), members = paste(m, collapse = ";"))
  }))
}
 
# Counts -> log2 relative abundance (the same transform used in the MaAsLin2 runs)
make_Y <- function(counts) {
  prop <- counts / rowSums(counts)
  Y <- apply(prop, 2, function(x) { x[x == 0] <- min(x[x > 0]) / 2; log2(x) })
  rownames(Y) <- rownames(counts)
  Y
}
 
# Covariates for the model (an intercept column is included)
cov_matrix <- function(meta, with_site = FALSE) {
  terms <- c("demographic_age", "anthropometric_bmi", "antibiotics_collapsed", NUC_PCS)
  if (with_site) terms <- c(terms, "general_site")
  X <- model.matrix(reformulate(terms), data = droplevels(meta))
  stopifnot(nrow(X) == nrow(meta))
  X
}
 
# The scan itself: for every SNP, test it against EVERY taxon at once.

scan_all <- function(G, Y, Xcov) {
  nS <- ncol(G); nT <- ncol(Y)
  empty <- matrix(NA_real_, nS, nT, dimnames = list(colnames(G), colnames(Y)))
  beta <- empty; se <- empty; p <- empty
  for (j in seq_len(nS)) {
    ok <- !is.na(G[, j])
    X  <- cbind(Xcov[ok, , drop = FALSE], snp = G[ok, j])
    q  <- qr(X)
    if (q$rank < ncol(X)) next               # SNP cannot be separated from the covariates
    df <- sum(ok) - q$rank
    Yo <- Y[ok, , drop = FALSE]
    bj <- qr.coef(q, Yo)[ncol(X), ]
    s2 <- colSums(qr.resid(q, Yo)^2) / df
    v  <- solve(crossprod(X))[ncol(X), ncol(X)]
    sj <- sqrt(s2 * v)
    beta[j, ] <- bj
    se[j, ]   <- sj
    p[j, ]    <- 2 * pt(-abs(bj / sj), df)
  }
  list(beta = beta, se = se, p = p)
}
 
# Shuffle genotypes between people (whole rows, so SNP linkage is kept),
# optionally only within groups such as sites
permute_idx <- function(n, strata = NULL) {
  if (is.null(strata)) return(sample.int(n))
  idx <- seq_len(n)
  for (s in unique(strata)) { w <- which(strata == s); idx[w] <- w[sample.int(length(w))] }
  idx
}
 
# Turn the result matrices into one long table
to_table <- function(lst) {
  nS <- nrow(lst$p); nT <- ncol(lst$p)
  tab <- data.frame(snp = rep(rownames(lst$p), times = nT),
                    taxon = rep(colnames(lst$p), each = nS))
  for (nm in names(lst)) tab[[nm]] <- as.vector(lst[[nm]])
  tab
}
 
# Print a summary, add BH q-values and permutation p-values, save files
report_scan <- function(tab, minp = NULL, label, prefix) {
  tab <- tab[!is.na(tab$p), ]
  tab$q_BH <- p.adjust(tab$p, "BH")
  tab <- tab[order(tab$p), ]
  n <- nrow(tab)
  lambda <- median(qchisq(tab$p, 1, lower.tail = FALSE)) / qchisq(0.5, 1)
 
  # QQ plot: points should follow the red line unless there are real signals
  png(paste0(prefix, "_qq.png"), width = 600, height = 600)
  e <- (seq_len(n) - 0.5) / n
  plot(-log10(e), -log10(tab$p), pch = 16, cex = 0.5, main = label,
       xlab = "Expected -log10(p)", ylab = "Observed -log10(p)")
  abline(0, 1, col = "red")
  dev.off()
  write.csv(tab, paste0(prefix, "_results.csv"), row.names = FALSE)
  invisible(tab)
}
 
 
